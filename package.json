{
  "name": "pi-flows",
  "version": "0.8.0",
  "private": false,
  "description": "Delegate pi work to isolated, budgeted children with verification loops and tracing.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "agent-delegation",
    "flows"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thulr/pi-flows.git"
  },
  "homepage": "https://github.com/Thulr/pi-flows#readme",
  "bugs": "https://github.com/Thulr/pi-flows/issues",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0",
    "pi": ">=0.82.0"
  },
  "files": [
    "agents/*.md",
    "presets/*.md",
    "extensions/pi-flows/**/*.ts",
    "extensions/pi-flows/**/*.mjs",
    "docs/README.md",
    "docs/tutorials/*.md",
    "docs/how-to/*.md",
    "docs/reference/*.md",
    "docs/explanation/*.md",
    "examples/**",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "CONTEXT.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-flows/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/Thulr/pi-flows/main/docs/images/flow-run-card.gif"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.82.0 <1.0.0",
    "@earendil-works/pi-ai": ">=0.82.0 <1.0.0",
    "@earendil-works/pi-coding-agent": ">=0.82.0 <1.0.0",
    "@earendil-works/pi-tui": ">=0.82.0 <1.0.0",
    "typebox": ">=1.1.0 <2.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/node": "26.2.0",
    "husky": "9.1.7",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "preflight": "node scripts/check-pi.mjs",
    "check": "npm run typecheck && npm run lint:length && npm run score:domain && npm run scan:privacy && npm test && npm run validate:agents && npm run validate:presets && npm run smoke && npm run pack:dry-run",
    "lint:length": "node scripts/check-file-length.mjs",
    "score:domain": "node scripts/domain-score.mjs",
    "scan:privacy": "node scripts/privacy-scan.mjs",
    "scan:privacy:staged": "node scripts/privacy-scan.mjs --staged",
    "smoke": "node scripts/smoke.mjs",
    "pack:dry-run": "node scripts/check-pack.mjs",
    "validate:agents": "node scripts/validate-agents.mjs",
    "validate:presets": "node --import tsx scripts/validate-presets.ts",
    "eval": "node --import tsx evals/run.mjs",
    "eval:compare": "node --import tsx evals/compare.mjs",
    "eval:review": "node evals/review.mjs",
    "eval:pareto": "node evals/pareto.mjs",
    "eval:select": "node --import tsx evals/select.mjs",
    "eval:failure": "node --import tsx evals/failure.mjs",
    "eval:release": "node --import tsx evals/release.mjs",
    "trace:report": "node --import tsx scripts/trace-report.mjs"
  }
}
